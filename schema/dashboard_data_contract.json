{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pharma Analytics Dashboard Data Contract",
  "description": "Formal JSON Schema contract for all data files fetched by the Pharma Analytics Scorecard frontend.",
  "type": "object",
  "properties": {
    "reps": {
      "oneOf": [
        {
          "type": "array",
          "description": "Complete list of sales reps (all reps, non-fixed sample size).",
          "items": {
            "type": "object",
            "required": [
              "rep_id",
              "territory_id",
              "compliance_pct",
              "rx_lift_pct",
              "samples",
              "quadrant",
              "trajectory_direction",
              "sample_size_flag"
            ],
            "properties": {
              "rep_id": { "type": "string" },
              "sales_rep_name": { "type": "string" },
              "territory_id": { "type": "string" },
              "is_active": { "type": "boolean" },
              "compliance_pct": { "type": "number" },
              "rx_lift_pct": { "type": "number" },
              "monthly_cadence": { "type": "number" },
              "target_monthly_cadence": { "type": "number" },
              "sample_ratio": { "type": "number" },
              "target_sample_ratio": { "type": "number" },
              "baseline_volume": { "type": "number" },
              "target_baseline_volume": { "type": "number" },
              "target_compliance_pct": { "type": "number" },
              "cei_score": { "type": "number" },
              "dominant_quadrant_cei": { "type": "string" },
              "samples": { "type": "integer" },
              "quadrant": { "type": "string" },
              "trajectory_direction": { "type": "string" },
              "sample_size_flag": { "type": "boolean" },
              "prescriber_count": { "type": "integer" },
              "total_target_calls": { "type": "integer" },
              "total_actual_calls": { "type": "integer" },
              "coaching_priority": { "type": "string" },
              "action_flag": { "type": "string" },
              "driver_bottleneck": { "type": "string" },
              "driver_recommendation": { "type": "string" },
              "calls_to_add": { "type": "number" },
              "calls_to_free": { "type": "number" },
              "net_call_delta": { "type": "number" },
              "hcps_with_increase": { "type": "integer" },
              "hcps_with_decrease": { "type": "integer" },
              "reallocation_recommendation": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "description": "Multi-mode rep scorecards dictionary.",
          "properties": {
            "hybrid": { "type": "array" },
            "synthetic": { "type": "array" }
          }
        }
      ]
    },

    "ml_results": {
      "type": "object",
      "description": "Machine learning model tournament benchmarks and held-out test evaluation.",
      "properties": {
        "hybrid": { "type": "object" },
        "synthetic": { "type": "object" },
        "best_model_summary": {
          "type": "object",
          "properties": {
            "model_label": { "type": "string" },
            "test_r2": { "type": "number" },
            "test_mae": { "type": "number" },
            "test_rmse": { "type": "number" },
            "overfitting_gap": { "type": "number" },
            "bootstrap_ci": { "type": "string" }
          }
        },
        "tournament_table": {
          "type": "array"
        }
      }
    },

    "attribution": {
      "type": "object",
      "description": "Global feature importance % and SHAP value contributions for driver attribution.",
      "properties": {
        "hybrid": { "type": "object" },
        "synthetic": { "type": "object" },
        "global_importance": { "type": "array" },
        "shap_contributions": { "type": "array" }
      }
    },

    "scatter_points": {
      "oneOf": [
        {
          "type": "array",
          "description": "HCP-level records for compliance vs Rx lift scatter plot correlation."
        },
        {
          "type": "object",
          "description": "Multi-mode scatter points dictionary.",
          "properties": {
            "hybrid": { "type": "array" },
            "synthetic": { "type": "array" }
          }
        }
      ]
    },

    "coaching_queue": {
      "oneOf": [
        {
          "type": "array",
          "description": "Prioritized daily task list of sales reps requiring coaching or intervention."
        },
        {
          "type": "object",
          "description": "Multi-mode coaching queue dictionary.",
          "properties": {
            "hybrid": { "type": "array" },
            "synthetic": { "type": "array" }
          }
        }
      ]
    },

    "pipeline_telemetry": {
      "type": "object",
      "description": "Execution stats and telemetry data for pipeline inspector.",
      "properties": {
        "hybrid": { "type": "object" },
        "synthetic": { "type": "object" },
        "initial_rows": { "type": "integer" },
        "after_privacy_filter": { "type": "integer" },
        "retained_rows": { "type": "integer" },
        "suppressed_rows": { "type": "integer" },
        "nulls_imputed": { "type": "integer" },
        "execution_time_sec": { "type": "number" }
      }
    }
  }
}
